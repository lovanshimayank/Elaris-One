generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id        String         @id @default(cuid())
  name      String         @unique
  code      String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  type      DepartmentType
  subjects  Subject[]
  users     User[]
}

model Subject {
  id           String     @id @default(cuid())
  semester     Int
  departmentId String
  createdAt    DateTime   @default(now())
  code         String     @unique
  name         String
  updatedAt    DateTime   @updatedAt
  notes        Note[]
  pyqs         PYQ[]
  department   Department @relation(fields: [departmentId], references: [id])
}

model User {
  id               String        @id @default(cuid())
  enrollmentNumber String        @unique
  fullName         String
  email            String        @unique
  password         String
  phone            String?
  role             UserRole      @default(STUDENT)
  semester         Int?
  departmentId     String?
  isVerified       Boolean       @default(false)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  bio              String?
  branch           String?
  college          String?
  github           String?
  linkedin         String?
  profileImage     String?
  section          String?
  skills           String[]
  year             Int?
  bookmarks        Bookmark[]
  notes            Note[]
  opportunities    Opportunity[]
  pyqs             PYQ[]
  department       Department?   @relation(fields: [departmentId], references: [id])

  @@index([enrollmentNumber])
}

model Note {
  id                   String           @id @default(cuid())
  title                String
  description          String?
  downloads            Int              @default(0)
  subjectId            String
  uploadedById         String
  createdAt            DateTime         @default(now())
  branch               String
  isApproved           Boolean          @default(false)
  isPublic             Boolean          @default(false)
  pdfUrl               String
  semester             Int
  thumbnail            String?
  updatedAt            DateTime         @updatedAt
  moderatedAt          DateTime?
  moderationCategories String[]
  moderationReasons    String[]
  moderationScore      Float?
  moderationStatus     ModerationStatus @default(PENDING)
  moderationSummary    String?
  bookmarks            Bookmark[]
  subject              Subject          @relation(fields: [subjectId], references: [id])
  uploadedBy           User             @relation(fields: [uploadedById], references: [id])
}

model PYQ {
  id                   String           @id @default(cuid())
  title                String
  year                 Int
  subjectId            String
  uploadedById         String
  createdAt            DateTime         @default(now())
  branch               String
  downloads            Int              @default(0)
  pdfUrl               String
  semester             Int
  updatedAt            DateTime         @updatedAt
  moderatedAt          DateTime?
  moderationCategories String[]
  moderationReasons    String[]
  moderationScore      Float?
  moderationStatus     ModerationStatus @default(PENDING)
  moderationSummary    String?
  bookmarks            Bookmark[]
  subject              Subject          @relation(fields: [subjectId], references: [id])
  uploadedBy           User             @relation(fields: [uploadedById], references: [id])
}

model Opportunity {
  id                   String           @id @default(cuid())
  title                String
  description          String
  company              String?
  applyLink            String?
  deadline             DateTime?
  type                 OpportunityType
  postedById           String
  createdAt            DateTime         @default(now())
  isActive             Boolean          @default(false)
  location             String?
  updatedAt            DateTime         @updatedAt
  moderatedAt          DateTime?
  moderationCategories String[]
  moderationReasons    String[]
  moderationScore      Float?
  moderationStatus     ModerationStatus @default(PENDING)
  moderationSummary    String?
  bookmarks            Bookmark[]
  postedBy             User             @relation(fields: [postedById], references: [id])
}

model Bookmark {
  id            String       @id @default(cuid())
  userId        String
  noteId        String?
  createdAt     DateTime     @default(now())
  opportunityId String?
  pyqId         String?
  note          Note?        @relation(fields: [noteId], references: [id])
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  pyq           PYQ?         @relation(fields: [pyqId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
}

enum UserRole {
  STUDENT
  FACULTY
  ADMIN
}

enum OpportunityType {
  INTERNSHIP
  JOB
  HACKATHON
  EVENT
}

enum DepartmentType {
  ENGINEERING
  MANAGEMENT
  PHARMACY
  LAW
  DESIGN
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}
