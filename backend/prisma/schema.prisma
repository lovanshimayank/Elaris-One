generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id        String         @id @default(cuid())
  name      String         @unique
  code      String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  type      DepartmentType
  subjects  Subject[]
  users     User[]
}

model Subject {
  id           String     @id @default(cuid())
  semester     Int
  departmentId String
  createdAt    DateTime   @default(now())
  code         String     @unique
  name         String
  updatedAt    DateTime   @updatedAt
  notes        Note[]
  pyqs         PYQ[]
  quizzes      Quiz[]
  department   Department @relation(fields: [departmentId], references: [id])
}

model User {
  id               String            @id @default(cuid())
  enrollmentNumber String            @unique
  fullName         String
  email            String            @unique
  password         String
  phone            String?
  role             UserRole          @default(STUDENT)
  semester         Int?
  departmentId     String?
  isVerified       Boolean           @default(false)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bio              String?
  branch           String?
  college          String?
  github           String?
  linkedin         String?
  profileImage     String?
  section          String?
  skills           String[]
  year             Int?
  bookmarks        Bookmark[]
  notifications    Notification[]
  notes            Note[]
  opportunities    Opportunity[]
  pyqs             PYQ[]
  quizzes          Quiz[]            @relation("QuizCreator")
  quizAttempts     QuizAttempt[]
  readingProgress  ReadingProgress[]
  department       Department?       @relation(fields: [departmentId], references: [id])

  @@index([enrollmentNumber])
}

model Note {
  id                   String           @id @default(cuid())
  title                String
  description          String?
  downloads            Int              @default(0)
  subjectId            String
  uploadedById         String
  createdAt            DateTime         @default(now())
  branch               String
  isApproved           Boolean          @default(false)
  isPublic             Boolean          @default(false)
  pdfUrl               String
  semester             Int
  thumbnail            String?
  updatedAt            DateTime         @updatedAt
  moderatedAt          DateTime?
  moderationCategories String[]
  moderationReasons    String[]
  moderationScore      Float?
  moderationStatus     ModerationStatus @default(PENDING)
  moderationSummary    String?
  bookmarks            Bookmark[]
  quizzes              Quiz[]
  subject              Subject          @relation(fields: [subjectId], references: [id])
  uploadedBy           User             @relation(fields: [uploadedById], references: [id])
}

model PYQ {
  id                   String           @id @default(cuid())
  title                String
  year                 Int
  subjectId            String
  uploadedById         String
  createdAt            DateTime         @default(now())
  branch               String
  downloads            Int              @default(0)
  pdfUrl               String
  semester             Int
  updatedAt            DateTime         @updatedAt
  moderatedAt          DateTime?
  moderationCategories String[]
  moderationReasons    String[]
  moderationScore      Float?
  moderationStatus     ModerationStatus @default(PENDING)
  moderationSummary    String?
  bookmarks            Bookmark[]
  subject              Subject          @relation(fields: [subjectId], references: [id])
  uploadedBy           User             @relation(fields: [uploadedById], references: [id])
}

model Opportunity {
  id                   String           @id @default(cuid())
  title                String
  description          String
  company              String?
  applyLink            String?
  deadline             DateTime?
  type                 OpportunityType
  postedById           String
  createdAt            DateTime         @default(now())
  isActive             Boolean          @default(false)
  location             String?
  updatedAt            DateTime         @updatedAt
  moderatedAt          DateTime?
  moderationCategories String[]
  moderationReasons    String[]
  moderationScore      Float?
  moderationStatus     ModerationStatus @default(PENDING)
  moderationSummary    String?
  bookmarks            Bookmark[]
  postedBy             User             @relation(fields: [postedById], references: [id])
}

model Bookmark {
  id            String       @id @default(cuid())
  userId        String
  noteId        String?
  createdAt     DateTime     @default(now())
  opportunityId String?
  pyqId         String?
  note          Note?        @relation(fields: [noteId], references: [id])
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  pyq           PYQ?         @relation(fields: [pyqId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
}

enum UserRole {
  STUDENT
  FACULTY
  ADMIN
}

enum OpportunityType {
  INTERNSHIP
  JOB
  HACKATHON
  EVENT
}

enum DepartmentType {
  ENGINEERING
  MANAGEMENT
  PHARMACY
  LAW
  DESIGN
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

enum NotificationType {
  SYSTEM
  APPROVED
  REJECTED
  OPPORTUNITY
  ANNOUNCEMENT
}

enum QuizType {
  GENERAL
  CHUNK
  FINAL
}

enum ReadingResourceType {
  NOTE
  PYQ
}

model Quiz {
  id             String               @id @default(cuid())
  title          String
  description    String?
  topic          String
  difficulty     String               @default("MEDIUM")
  subjectId      String?
  noteId         String?
  createdById    String
  quizType       QuizType             @default(GENERAL)
  sourceType     ReadingResourceType?
  sourceId       String?
  startPage      Int?
  endPage        Int?
  idempotencyKey String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  subject   Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  note      Note?          @relation(fields: [noteId], references: [id], onDelete: SetNull)
  createdBy User           @relation("QuizCreator", fields: [createdById], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([subjectId])
  @@index([sourceType, sourceId])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  question      String
  options       String[]
  correctOption Int
  explanation   String?
  order         Int
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, order])
}

model QuizAttempt {
  id             String   @id @default(cuid())
  quizId         String
  userId         String
  score          Int
  totalQuestions Int
  answers        Json
  idempotencyKey String?  @unique
  completedAt    DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
  @@index([userId, completedAt])
}

model ReadingProgress {
  id           String              @id @default(cuid())
  userId       String
  resourceType ReadingResourceType
  resourceId   String
  totalPages   Int
  lastPage     Int                 @default(1)
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages ReadingPageProgress[]

  @@unique([userId, resourceType, resourceId])
  @@index([userId, updatedAt])
}

model ReadingPageProgress {
  id         String   @id @default(cuid())
  progressId String
  pageNumber Int
  visitedAt  DateTime @default(now())

  progress ReadingProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([progressId, pageNumber])
}
